# Google AI (Gemini) — powers POST /api/normalize-route.
# Without it the route falls back to the preloaded Bengaluru demo routes.
GEMINI_API_KEY=

# Supabase — powers POST/GET /api/routes (the LOGGED ROUTES layer).
# SUPABASE_URL accepts either the project URL or the NEXT_PUBLIC_ variant.
# Prefer the service-role key on the server; it bypasses row level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public equivalents (used by the browser bundle in the full app).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
