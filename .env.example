# Copy to .env.local and fill in with your Supabase project values.
# Supabase dashboard -> Project Settings -> API
#
# These are read only on the server (app/api/routes), so they never reach the
# browser bundle. On a host, add them as runtime secrets with these same names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Older local setups may use the public names instead; they still work.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
