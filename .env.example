# Copy to .env.local and add the values from Supabase Project Settings → API.
# Without these the app still runs: community routes and bookings fall back to
# a local JSON file under .data/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Seat requests (bookings) are written with the service-role key because that
# table has RLS enabled and no anon policies. Server-only: never expose it.
# Without it, bookings use the local .data/bookings.json file instead.
SUPABASE_SERVICE_ROLE_KEY=

# AI route normalization (ai-maps module). Google AI Studio API key.
# Without it, /api/normalize-route serves its demo route and community
# submissions are saved as straight geocoded lines instead of road-snapped ones.
GEMINI_API_KEY=
